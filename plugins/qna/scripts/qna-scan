#!/usr/bin/env python3
"""Print the conversation /qna:ask has not scanned yet.

    qna-scan --session <id> --project <abs> --transcript <abs>
    qna-scan --session <id> --project <abs> --transcript <abs> --mark

Three jobs, all of which have to be a script rather than a judgement call:

  * Filter.  A working session's transcript is mostly tool calls, tool results
    and thinking — 97% of the bytes in the session that prompted this script.
    Only user messages and assistant prose are conversation. Filtering is the
    difference between a file that cannot be read at all and one that can.

  * Window.  The watermark in .meta says where the last scan stopped. Reading
    from there is the only way a second /qna:ask in a long session costs less
    than the first. The model never computes the boundary and never sees a
    timestamp it has to reason about: it runs this, it reads what comes back.

  * Compaction cut.  Of what is left, print only the turns behind the newest
    compact summary. Everything after it sits verbatim in the model's context,
    so printing it is a second copy of what the model is already reading — paid
    for once here and then again on every request for the rest of the session.
    The frequent outcome is therefore an empty window, and that is the tool
    working: it means the context scan has the stretch covered.

--mark advances the watermark, and /qna:ask runs it as soon as the survivors are
recorded — not at the end. Marking last looked safer, on the reasoning that an
interrupted run should re-read rather than skip. In practice it swallowed the
turns the user's answers were given in, and a run that never reached the end left
the watermark unset entirely: eight invocations in one session, all eight reading
from the first turn, the last of them printing 139 KB. Recording is what makes
the stretch durable, so marking belongs immediately after it.

Resume is by uuid, with the timestamp as fallback. A uuid is exact; timestamps
repeat and clocks move. If neither resolves, the whole conversation is printed
rather than a guessed window — over-reading is visible and cheap, under-reading
is neither.

  exit 0   printed a window (possibly empty)
  exit 2   the transcript cannot be read (missing, moved, format changed)
"""

import argparse
import os
import signal
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import qna_lib  # noqa: E402

# The output is long by nature and will get piped through head or grep. Die
# quietly when the reader goes away instead of spewing a traceback that looks
# like the transcript is broken.
try:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError):
    pass

EXIT_OK = 0
EXIT_UNREADABLE = 2

# Priced, not guessed. Output lands in the model's context and is re-sent with
# every request for the rest of the session, so this cap is a per-session
# multiplier rather than a one-off, and one real session paid it eight times over.
#
# The unit is characters, and what that costs in tokens depends on the language:
# English prose runs about 4 chars per token, Chinese closer to 1. So 30_000 is
# roughly 7k tokens of English and up to 30k of Chinese — the old 200_000 was 50k
# and 200k respectively, the latter being the entire context window. Budget
# against the pessimistic end; a transcript's language is not ours to predict.
#
# On overflow the newest text is kept and the drop is reported: a cap that stays
# quiet reads as "you have seen everything".
MAX_CHARS = 30_000


def resolve_window(turns, mark_uuid, mark_ts):
    """Turns after the watermark, plus how the boundary was found."""
    if mark_uuid:
        for i, t in enumerate(turns):
            if t["uuid"] == mark_uuid:
                return turns[i + 1:], "uuid"
    if mark_ts:
        after = [t for t in turns if t["ts"] > mark_ts]
        if len(after) != len(turns):
            return after, "timestamp"
    return turns, "everything"


def split_at_last_compaction(window):
    """Turns the model can no longer see, and how many it still can.

    A compact summary entry replaces everything before it, so from that entry
    onward the window sits verbatim in context and printing it off disk buys
    nothing — it pays full price for a second copy of what the model is already
    reading. Only the stretch before the newest summary is genuinely out of
    reach, and that stretch is the entire reason to touch the transcript.

    The summary entry itself is in context too, hence the cut lands on its index
    rather than after it. Multiple compactions: the newest one wins, because
    each supersedes the last.
    """
    cut = 0
    for i, t in enumerate(window):
        if t["compacted"]:
            cut = i
    return window[:cut], len(window) - cut


def render(turns):
    out = []
    for t in turns:
        tag = " · context compaction" if t["compacted"] else ""
        out.append("[{}] {}{}\n{}".format(t["ts"], t["role"], tag, t["text"].strip()))
    return "\n\n".join(out)


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--session", required=True)
    ap.add_argument("--project")
    ap.add_argument("--transcript")
    ap.add_argument("--mark", action="store_true",
                    help="record the newest turn as scanned; run this last")
    args = ap.parse_args()

    meta = qna_lib.load_meta(args.session, args.project)
    path = args.transcript or meta.get("transcript_path")
    if not path or not os.path.exists(path):
        print("qna-scan: transcript unreadable — scan the conversation in your "
              "context instead.", file=sys.stderr)
        return EXIT_UNREADABLE

    try:
        turns = list(qna_lib.iter_turns(path))
    except Exception:
        print("qna-scan: transcript unreadable — scan the conversation in your "
              "context instead.", file=sys.stderr)
        return EXIT_UNREADABLE

    if args.mark:
        if not turns:
            print("qna-scan: nothing to mark, transcript held no conversation.")
            return EXIT_OK
        last = turns[-1]
        meta["scan_uuid"] = last["uuid"]
        meta["scan_ts"] = last["ts"]
        qna_lib.save_meta(args.session, meta, args.project)
        print("qna-scan: watermark at {} — the next scan starts after this "
              "point.".format(last["ts"]))
        return EXIT_OK

    window, how = resolve_window(turns, meta.get("scan_uuid"), meta.get("scan_ts"))

    if not window:
        print("qna-scan: nothing new since {}. The conversation in your context "
              "is the only source this run.".format(meta.get("scan_ts")))
        return EXIT_OK

    window, in_context = split_at_last_compaction(window)

    if not window:
        print("qna-scan: {} turns in the window, none of them behind a "
              "compaction — every one is still verbatim in your context. Scan "
              "it there; the transcript has nothing to add this run."
              .format(in_context))
        return EXIT_OK

    body = render(window)
    dropped = 0
    if len(body) > MAX_CHARS:
        keep = []
        size = 0
        for t in reversed(window):
            piece = len(t["text"]) + 40
            if size + piece > MAX_CHARS:
                dropped += 1
                continue
            size += piece
            keep.append(t)
        keep.reverse()
        body = render(keep)
        window = keep

    head = ["qna-scan · {} turns · {:.1f} KB".format(len(window), len(body) / 1024)]
    # Every turn printed is now, by construction, behind a compaction. That is
    # not a caveat on the output, it is what the output is for: these are the
    # only turns your context does not hold, so what follows is the record.
    head.append("all of these are behind a context compaction — they reach you "
                "only as a summary, so treat what follows as the record")
    if in_context:
        head.append("{} newer turns not printed: still verbatim in your context, "
                    "scan them there".format(in_context))
    if how == "everything":
        head.append("no watermark yet — this reaches back to the first turn")
    else:
        head.append("window since {} (resumed by {})".format(meta.get("scan_ts"), how))
    if dropped:
        head.append("{} older turns dropped to stay under {} KB — they were NOT "
                    "scanned".format(dropped, MAX_CHARS // 1024))

    print("\n  ".join(head))
    print()
    print(body)
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
