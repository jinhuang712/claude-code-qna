#!/usr/bin/env python3
"""Switch the /qna:ask question validator on and off.

    qna-mark --session <id> --project <abs> --on
    qna-mark --session <id> --project <abs> --off
    qna-mark --session <id> --project <abs> --status

The validator only runs while a marker file exists, so where that file lives
has to be something the writer and the reader agree on exactly. Having the
model build the path itself is what made that fragile: the shell it runs
commands in has no CLAUDE_PROJECT_DIR, so the path collapsed to whatever the
working directory happened to be, while the hook resolved it from its own
payload. Two answers to the same question — and the failure was silent, because
"no marker" means "not inside /qna:ask", so every malformed question sailed
straight through.

So the model never touches the path. SessionStart resolves it once, injects the
whole command, and this script is the only thing that writes the marker.
"""

import argparse
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import qna_lib  # noqa: E402


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--session", required=True)
    ap.add_argument("--project")
    mode = ap.add_mutually_exclusive_group(required=True)
    mode.add_argument("--on", action="store_true")
    mode.add_argument("--off", action="store_true")
    mode.add_argument("--status", action="store_true")
    args = ap.parse_args()

    if args.status:
        live = qna_lib.marker_is_live(args.session, args.project)
        print("Validator on." if live else "Validator off.")
        return 0

    if args.on:
        # create=True makes the directory, which is the other half of the old
        # breakage: a bare touch cannot create .qna/ and failed outright the
        # first time /qna:ask ran in a project.
        path = qna_lib.active_path(args.session, args.project)
        with open(path, "w", encoding="utf-8") as f:
            f.write(f"{int(time.time())}\n")
        print(
            "Validator on: questions need 3-4 options and a preview per option. "
            "Expires after 30 minutes."
        )
        return 0

    path = qna_lib.active_path(args.session, args.project, create=False)
    try:
        os.remove(path)
    except FileNotFoundError:
        pass  # --off is idempotent: it has to be safe to call after a crash.
    except OSError as e:
        print(f"Could not remove marker: {e}", file=sys.stderr)
        return 1
    print("Validator off.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
